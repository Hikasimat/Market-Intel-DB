# ============================================================
# Root .gitignore — MarketIntel DB
# ============================================================

# Python bytecode & compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pdb

# Virtual environments
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/
backend/env/
**/.venv/
**/venv/
**/env/

# Environment secrets & credentials — NEVER commit
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
frontend/.env.local
frontend/.env.production.local
frontend/.env.development.local
service-account*.json
credentials*.json
client_secret*.json
google_client_secret*.json
google-credentials*.json
token*.json
*.bak
*.backup
*.env.backup

# Cloudflare Tunnel & SSL Certificates
.cloudflared/
*.pem
*.key
*.crt
*.pfx
cert.pem
tunnel-*.json

# Databases & local SQLite DBs
*.sqlite3
*.sqlite3-journal
*.sqlite
*.db
*.db-journal
db.sqlite3
backend/db.sqlite3
backend/test_*.sqlite3
**/test_*.sqlite3
test_*.db
backend/settings_*test*.py
backend/settings_local*.py

# Django generated static & user media
staticfiles/
backend/staticfiles/
media/
backend/media/
**/media/
uploads/
backend/uploads/
**/uploads/
backend/attachments/
attachments/
social_posts/
**/social_posts/

# WhatsApp & WAHA session data
.waha/
waha-data/
waha_data/
sessions/

# Testing, typing & coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
*.lcov
htmlcov/
.tox/
.nox/

# Frontend, Node & Bundlers
node_modules/
frontend/node_modules/
**/node_modules/
dist/
build/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
.vite/
**/.vite/
.eslintcache
.vercel/
*.tsbuildinfo

# Background worker & process files
*.pid
celerybeat-schedule*

# Logs & temporary files
*.log
backend/*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
scratch/
backend/scratch/
**/scratch/
*.tmp
*.temp
test_*.py

# IDEs, Editors & AI Assistants
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
.agents/
.gemini/
.antigravity/
.claude/
.cursor/
.windsurf/

# Operating System files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
*.lnk
