# ============================================================
# Root .gitignore — MarketIntel DB
# ============================================================

# Python bytecode & compiled files
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.pdb
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/
backend/env/
**/.venv/
**/venv/
**/env/

# Environment secrets & credentials — NEVER commit
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*
**/.env.local
**/.env.*.local
!.env.example
!**/.env.example
service-account*.json
credentials*.json
client_secret*.json
google_client_secret*.json
google-credentials*.json
token*.json
*.bak
*.backup
*.env.backup

# Cloudflare Tunnel, SSL Certificates & Keys
.cloudflared/
**/.cloudflared/
*.pem
*.key
*.crt
*.pfx
cert.pem
tunnel-*.json
id_rsa*
id_ed25519*

# Databases & local SQLite DBs
*.sqlite3
*.sqlite3-journal
*.sqlite
*.db
*.db-journal
db.sqlite3
backend/db.sqlite3
**/db.sqlite3
backend/test_*.sqlite3
**/test_*.sqlite3
test_*.db
backend/settings_*test*.py
backend/settings_local*.py
**/settings_*test*.py
**/settings_local*.py

# Django generated static & user media / attachments
staticfiles/
backend/staticfiles/
**/staticfiles/
media/
backend/media/
**/media/
uploads/
backend/uploads/
**/uploads/
backend/attachments/
attachments/
**/attachments/
social_posts/
**/social_posts/
.tempmediaStorage/
**/.tempmediaStorage/
.user_uploaded/
**/.user_uploaded/

# WhatsApp & WAHA session data
.waha/
**/.waha/
waha-data/
waha_data/
**/waha-data/
**/waha_data/
sessions/
**/sessions/

# Testing, typing & coverage
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.hypothesis/
.coverage
.coverage.*
coverage.xml
*.lcov
htmlcov/
.tox/
.nox/

# Frontend, Node & Bundlers
node_modules/
frontend/node_modules/
**/node_modules/
dist/
build/
frontend/dist/
frontend/dist-ssr/
**/dist/
**/dist-ssr/
frontend/.vite/
.vite/
**/.vite/
.eslintcache
.vercel/
.turbo/
.output/
*.tsbuildinfo

# Background worker & process files
*.pid
celerybeat-schedule*

# Logs & temporary files
*.log
backend/*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
scratch/
backend/scratch/
**/scratch/
*.tmp
*.temp
test_*.py

# IDEs, Editors & AI Assistants
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
.agents/
.gemini/
.antigravity/
.claude/
.cursor/
.windsurf/

# Large evidence bundles & REA analysis dumps (>100MB blocked by GitHub)
rea_evidence_bundle.json
**/rea_evidence_bundle.json
docs/**/rea-analysis/*.json
docs/**/rea-analysis/*.bundle

# Operating System files
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.swp
*.swo
*~
*.lnk
