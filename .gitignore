# ============================================================
# Root .gitignore — MarketIntel
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb

# Databases & local SQLite test DBs
*.sqlite3
*.sqlite
*.db
db.sqlite3
backend/settings_*test*.py
backend/settings_local*.py

# Virtual environments
.venv/
venv/
env/
backend/.venv/
backend/venv/
backend/env/

# Environment secrets — NEVER commit
.env
.env.*
!.env.example
backend/.env
frontend/.env.local
frontend/.env.production.local
frontend/.env.development.local

# Django generated & media
staticfiles/
media/
backend/media/
uploads/
backend/attachments/

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
frontend/node_modules/
dist/
build/
frontend/dist/
frontend/dist-ssr/
.eslintcache

# Vercel
.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDEs
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

