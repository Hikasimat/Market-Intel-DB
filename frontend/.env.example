# Frontend environment variables
# Copy this file to .env.local for local development
# NEVER commit .env.local to Git

# The backend API base URL.
# Local Development: 
#   When using the Vite dev server proxy, keep this as /api
# Production (AWS Amplify):
#   Set this to the public HTTPS URL of your EC2 backend API.
#   Example: VITE_API_BASE_URL=https://api.yourdomain.com/api
#   DO NOT include trailing slashes.
#   NEVER put backend secrets (like AWS keys or DB passwords) in VITE_* variables.
VITE_API_BASE_URL=/api
