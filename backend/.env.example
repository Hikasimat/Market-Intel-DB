# =============================================================================
# backend/.env.example
# Copy this file to .env and fill in values.
# NEVER commit .env to Git.
# =============================================================================

# =============================================================================
# LOCAL DEVELOPMENT (DB_* vars — used when DATABASE_URL is not set)
# =============================================================================
DB_NAME=marketintel
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# DJANGO CORE
# =============================================================================
# Generate a strong key for production:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-replace-me-in-production

# Set False in production
DEBUG=True

# Comma-separated. In production: your EC2 domain + localhost for internal checks.
# Example: YOUR_BACKEND_DOMAIN,127.0.0.1,localhost
ALLOWED_HOSTS=127.0.0.1,localhost

# =============================================================================
# DATABASE (PRODUCTION — Amazon RDS PostgreSQL)
# =============================================================================
# Leave empty for local dev (DB_* vars above are used instead).
# In production on EC2, set this to the Amazon RDS connection string.
#
# Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Optional parameters (e.g. for TLS):
#   ?sslmode=require
#   ?sslmode=verify-full&sslrootcert=/path/to/global-bundle.pem
DATABASE_URL=
CONN_MAX_AGE=600
DB_SSL_REQUIRE=true

# =============================================================================
# EMAIL / MAIL CREDENTIALS
# =============================================================================
# This key decrypts existing MailAccount SMTP/IMAP app passwords stored in DB.
# CRITICAL: Use the SAME key that was used when credentials were first encrypted.
# Do NOT generate a new key — it will break existing credential decryption.
MAIL_CREDENTIALS_ENCRYPTION_KEY=

# Base URL used to build email open-tracking pixel links.
# In production: https://YOUR_BACKEND_DOMAIN
# In local dev: http://localhost:8000 or a Cloudflare Quick Tunnel URL
EMAIL_TRACKING_BASE_URL=http://localhost:8000

# Global server-side kill switch for the open-tracking pixel.
#   true  — the pixel may be added, but ONLY to emails where the sender ticks
#           "Enable email open tracking" (unchecked by default on every email).
#   false — the pixel is NEVER added, even if the client asks for it.
# Per-email tracking is always OFF unless explicitly requested. Pixels hurt
# deliverability with some providers, so consider false in production if mail
# is landing in spam. (Change this in your deployment's environment/secret store.)
EMAIL_OPEN_TRACKING_ENABLED=true

# Email recipient address verification method:
#   mx_only    — syntax + MX lookup only (safe for EC2 and any env where port 25 is blocked)
#   smtp_local — also probe SMTP port 25 (local dev only)
EMAIL_VERIFICATION_PROVIDER=mx_only

# =============================================================================
# CORS / CSRF
# =============================================================================
# In production, set to your actual frontend domain:
# Example: CORS_ALLOWED_ORIGINS=https://marketinteldbapp.hikasimat.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# =============================================================================
# AMAZON S3 / OBJECT STORAGE
# =============================================================================
# Set USE_OBJECT_STORAGE=true in production to use S3.
USE_OBJECT_STORAGE=false
# Leave AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY empty in production 
# if your EC2 instance uses an attached IAM Role (recommended).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1

# =============================================================================
# GOOGLE OAUTH & GMAIL INTEGRATION
# =============================================================================
# Obtain these from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs.
# Web application client ID & secret:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Authorized redirect URI for Google Login:
# In local dev: http://localhost:5173/auth/google/callback
# In production: https://marketinteldbapp.hikasimat.com/auth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Authorized redirect URI for separate Gmail Mailbox OAuth consent:
# In local dev: http://localhost:5173/auth/gmail/callback
# In production: https://marketinteldbapp.hikasimat.com/auth/gmail/callback
GMAIL_OAUTH_REDIRECT_URI=http://localhost:5173/auth/gmail/callback

# Authorized redirect URI for the SEPARATE, optional Google Calendar consent
# (scope: https://www.googleapis.com/auth/calendar.events). Used by the LQ
# "Google Meet" meeting option. Must be added to the same OAuth client above, and the
# Google Calendar API must be enabled in the Google Cloud project.
# In local dev: http://localhost:5173/auth/calendar/callback
# In production: https://marketinteldbapp.hikasimat.com/auth/calendar/callback
CALENDAR_OAUTH_REDIRECT_URI=http://localhost:5173/auth/calendar/callback
# Default Google Meet event length in minutes
MEETING_DEFAULT_DURATION_MINUTES=30

# Public URL of the frontend application:
# In production: https://marketinteldbapp.hikasimat.com
FRONTEND_URL=http://localhost:5173

# =============================================================================
# OPTIONAL
# =============================================================================
GEMINI_API_KEY=

# =============================================================================
# DIGITAL MARKETING & SOCIAL MEDIA MODULES
# =============================================================================
# Meta (Instagram Professional Accounts, Facebook Pages, Meta Marketing API)
# Register a Meta Developer App (Type: Business) at https://developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=http://localhost:5173/digital-marketing/instagram
META_FACEBOOK_REDIRECT_URI=http://localhost:5173/digital-marketing/facebook
# Optional: Set custom Facebook scopes (defaults to pages_show_list,pages_read_engagement,pages_manage_posts)
# If pages_manage_posts is not yet added under Use Cases in Meta Developer App, you can set:
# META_FACEBOOK_SCOPES=pages_show_list,pages_read_engagement

# Twitter / X API v2 (Tweets, Profile, Metrics, X Ads)
# Register an App at https://developer.twitter.com/en/portal/dashboard
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=http://localhost:5173/digital-marketing/twitter

